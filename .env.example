# OpenAI API Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-sol

# Rate Limiting (optional)
# If set, limits demo users to this many OpenAI API requests per 24-hour period per IP
# Users can bypass the limit by providing their own OpenAI API key
# Leave unset or empty to disable rate limiting
DEMO_RATE_LIMIT=

# Reasoning effort for query generation (optional; gpt-5 / o-series models only)
# One of: none, minimal, low, medium, high, xhigh, max
# Leave empty to omit the parameter entirely (provider default)
OPENAI_REASONING_EFFORT=

# Eval harness only (optional, defaults off)
# When "true", /api/query/generate honors client-requested model + effort overrides
EVAL_ALLOW_MODEL_OVERRIDE=

# Trusted Proxies (optional)
# Comma-separated list of trusted proxy IPs for rate limiting
TRUSTED_PROXIES=

# ============================================================================
# Authentication (optional - all 3 required to enable auth mode)
# When not set, the app uses localStorage (current default behavior)
# ============================================================================
AUTH_OIDC_ISSUER=              # e.g. https://auth.example.com/application/o/dataquery-pro/
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_SECRET=                   # JWT signing key: openssl rand -hex 32
AUTH_URL=                      # e.g. http://localhost:3000 (required by Auth.js v5)
                               # Behind a reverse proxy set the PUBLIC https origin
                               # (e.g. https://data.example.com) so OIDC callbacks and
                               # secure session cookies are built for the right host.
# Comma-separated list of group names, group object IDs, or App Role values that
# grant admin. Matched case-insensitively against the merged `groups` + `roles`
# claims, so one value works on either provider:
#   Authentik  -> group name, e.g. dataquery-admins
#   Entra ID   -> group object GUID, or an App Role value (roles claim)
AUTH_ADMIN_GROUP=dataquery-admins

# ---- Provider shape (optional; defaults reproduce Authentik behavior) --------
# Auth.js provider id. This forms the callback URL /api/auth/callback/<id>, so
# changing it means re-registering the redirect URI at your identity provider.
# Leave unset unless you have a reason to change it.
AUTH_OIDC_PROVIDER_ID=          # default: authentik

# Display name on the sign-in button ("Sign in with ...").
AUTH_OIDC_PROVIDER_NAME=        # default: Authentik   e.g. Microsoft

# Space-separated scopes. The default requests Authentik's custom `groups` scope.
# Entra has NO groups scope and will reject it -- set the line below for Entra and
# emit group/role claims via the app registration's optional claims instead.
AUTH_OIDC_SCOPES=               # default: openid email profile groups
                                # Entra: openid email profile

# For Azure Entra ID:
#   AUTH_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   AUTH_OIDC_PROVIDER_NAME=Microsoft
#   AUTH_OIDC_SCOPES=openid email profile
# See docs/guides/azure-entra-setup.md

# Reverse-proxy only (optional). Set both when the app runs behind a
# TLS-terminating proxy. NEXTAUTH_URL is the legacy alias that next-auth/jwt's
# getToken() still reads; AUTH_TRUST_HOST tells Auth.js to trust the proxy's
# forwarded host. Leave empty for a direct localhost deployment.
AUTH_TRUST_HOST=               # e.g. true
NEXTAUTH_URL=                  # same value as AUTH_URL

# App Database (required when auth is enabled)
# PostgreSQL connection string for storing user data, connections, reports, etc.
APP_DATABASE_URL=              # e.g. postgres://user:pass@localhost:5432/dataquery_app

# Encryption (required when auth is enabled)
# Used to encrypt database connection passwords stored in the app database
APP_ENCRYPTION_KEY=            # 64-char hex string: openssl rand -hex 32
